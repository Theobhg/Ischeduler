{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "dependsOn": [
        "^db:generate"
      ],
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:reset": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "outputs": [
        "generated/**"
      ]
    },
    "db:push": {
      "cache": false
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "GATEWAY_URL",
    "GATEWAY_PORT",
    "GATEWAY_ADAPTER",
    "MOCK_FAILURE_RATE",
    "API_STATUS_CALLBACK_URL",
    "SEND_INTERVAL_MS",
    "WORKER_CONCURRENCY",
    "WORKER_ATTEMPTS",
    "WORKER_BACKOFF_MS",
    "VITE_API_URL"
  ]
}