# ==============================================
# Application
# ==============================================
TZ=America/Sao_Paulo

LOG_LEVEL=info

# ==============================================
# Databases
# ==============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379

# ==============================================
# API
# ==============================================
API_URL=http://localhost:3333

# ==============================================
# Gateway
# ==============================================
GATEWAY_PORT=4000
GATEWAY_ADAPTER=mock
# MOCK_FAILURE_RATE=0 — float 0–1, 0 = always succeed
MOCK_FAILURE_RATE=0
API_STATUS_CALLBACK_URL=http://localhost:3333/api/gateway/status

# ==============================================
# Worker
# ==============================================
# Demo: 60000 (1 minute). Production: 3600000 (1 hour)
SEND_INTERVAL_MS=60000
WORKER_CONCURRENCY=1
WORKER_ATTEMPTS=3
WORKER_BACKOFF_MS=30000
GATEWAY_URL=http://localhost:4000

# ==============================================
# Web
# ==============================================
VITE_API_URL=http://localhost:3333
